# Configuración de ejemplo para producción
# Copia este archivo como .env y ajusta los valores

# Entorno
NODE_ENV=production

# Servidor HTTP
PORT=3000
ENABLE_HTTP=false

# Nombre del bot
BOT_NAME=Optibot-Production

# Logs
LOG_LEVEL=info

# Reintentos automáticos
MAX_RETRIES=10
RETRY_DELAY=5000

# WhatsApp
WA_BROWSER_NAME=BuilderBot
WA_BROWSER_VERSION=14.4.1
