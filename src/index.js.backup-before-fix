/**
 * bot.js
 *
 * Bot de WhatsApp usando Baileys v6.6.0 (no requiere forzar `version`).
 * Incluye:
 * 1. Persistencia en ./auth_info
 * 2. Mostrar QR con printQRInTerminal en la primera ejecución
 * 3. Manejo de DisconnectReason y errores de stream (515)
 * 4. Manejo seguro de eliminación de directorios
 */

const {
	default: makeWASocket,
	useMultiFileAuthState,
	DisconnectReason,
	Browsers,
} = require("@whiskeysockets/baileys"); // v6.6.0
const qrcode = require("qrcode-terminal");
const fs = require("fs");
const path = require("path");

const diasSabado = "9 y Sábado 30 agosto";

// ----------------------------------
// FUNCIONES AUXILIARES
// ----------------------------------

/**
 * Función segura para eliminar el directorio de autenticación
 * Maneja errores EBUSY y otros problemas de archivos bloqueados
 */
async function safeRemoveAuthDir() {
	const authPath = "./auth_info";
	let attempts = 0;
	const maxAttempts = 5;

	while (attempts < maxAttempts) {
		try {
			if (fs.existsSync(authPath)) {
				// Intentar cambiar permisos de todos los archivos primero
				try {
					const files = fs.readdirSync(authPath, { recursive: true });
					for (const file of files) {
						const filePath = path.join(authPath, file);
						if (fs.statSync(filePath).isFile()) {
							fs.chmodSync(filePath, 0o666);
						}
					}
				} catch (permError) {
					console.log("⚠️ No se pudieron cambiar permisos:", permError.message);
				}

				// Intentar eliminar el directorio
				fs.rmSync(authPath, { recursive: true, force: true });
				console.log("🗑️ Directorio de autenticación eliminado exitosamente.");
				return true;
			}
			return true; // No existe, no hay nada que eliminar
		} catch (error) {
			attempts++;
			console.log(
				`⚠️ Intento ${attempts}/${maxAttempts} fallido:`,
				error.message
			);

			if (error.code === "EBUSY" || error.code === "EPERM") {
				if (attempts < maxAttempts) {
					console.log(
						`⏱️ Esperando ${attempts * 2} segundos antes de reintentar...`
					);
					await new Promise((resolve) => setTimeout(resolve, attempts * 2000));
				}
			} else {
				// Para otros errores, no reintentar
				console.error("❌ Error no recuperable:", error.message);
				return false;
			}
		}
	}

	console.error(
		"❌ No se pudo eliminar el directorio después de varios intentos."
	);
	console.log(
		"🔧 Intenta eliminar manualmente el directorio './auth_info' y reiniciar."
	);
	return false;
}

// -----------------------
// FUNCIONES DE MENSAJES
// -----------------------
async function handleMessage(sock, sender, messageContent) {
	const lowerCaseMessage = messageContent.toLowerCase();

	if (/hola|buenos días|buenas tardes|buenos dias/.test(lowerCaseMessage)) {
		await sendWelcomeMessage(sock, sender);
		return;
	}

	switch (lowerCaseMessage) {
		case "1":
			await sendOpeningHours(sock, sender);
			break;
		case "2":
			await sendVisualCheckMessage(sock, sender);
			break;
		case "3":
			await sendLocationMessage(sock, sender);
			break;
		case "4":
			await sendBankAccountMessage(sock, sender);
			break;
		case "gracias":
			await sendThanksMessage(sock, sender);
			break;
		default:
			// Opcional: mensaje por defecto
			break;
	}
}

